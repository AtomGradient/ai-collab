{
  "schema_version": 1,
  "profiles": [
    {
      "profile_id": "runtime-profile.inert",
      "display_name": "Inert (test fixture)",
      "executable": "/usr/bin/tail",
      "arguments": ["-f", "/dev/null"],
      "working_directory": ".",
      "process_match": "tail",
      "accepts_typed_delivery": false,
      "vendor_lifecycle": null,
      "safe_close": {
        "idle_detection": "always",
        "drain_sequence": []
      },
      "startup_gate": null
    },
    {
      "profile_id": "runtime-profile.codex",
      "display_name": "Codex",
      "executable": "codex",
      "arguments": ["--dangerously-bypass-approvals-and-sandbox", "--no-alt-screen"],
      "working_directory": "bundle",
      "process_match": "codex",
      "accepts_typed_delivery": true,
      "vendor_lifecycle": {
        "adapter_id": "vendor-lifecycle.codex-cli-v1",
        "continuity_binding_ref": "vendor-session-slot:primary"
      },
      "safe_close": {
        "idle_detection": "always",
        "drain_sequence": []
      },
      "startup_gate": {
        "scope": "harness_verified_workspace",
        "prompt_rules": [
          {
            "rule_id": "startup.codex-workspace-trust",
            "prompt_pattern": "(?s)You\\s+are\\s+in.*Do\\s+you\\s+trust\\s+the\\s+contents\\s+of\\s+this\\s+directory\\?.*1\\.\\s+Yes,\\s+continue.*2\\.\\s+No,\\s+quit",
            "confirm_sequence": ["1", "\r"],
            "requires_workspace_path": true
          },
          {
            "rule_id": "startup.codex-update-skip",
            "prompt_pattern": "(?s)Update\\s+available!\\s+\\S+\\s*->\\s*\\S+.*Release\\s+notes:\\s+https://github\\.com/openai/codex/releases/latest.*›\\s*1\\.\\s*Update\\s+now\\s+\\(runs\\s+`[^`\\r\\n]{1,200}`\\)\\s*2\\.\\s*Skip\\s*3\\.\\s*Skip\\s+until\\s+next\\s+version\\s*Press\\s+enter\\s+to\\s+continue",
            "confirm_sequence": ["2"],
            "requires_workspace_path": true
          }
        ],
        "ready_pattern": "(?m)^\\s*›(?!\\s*\\d+\\.).*$",
        "timeout_seconds": 180
      }
    },
    {
      "profile_id": "runtime-profile.claude",
      "display_name": "Claude",
      "executable": "claude",
      "arguments": ["--dangerously-skip-permissions", "--system-prompt", "."],
      "working_directory": "bundle",
      "process_match": "claude",
      "accepts_typed_delivery": true,
      "vendor_lifecycle": {
        "adapter_id": "vendor-lifecycle.claude-cli-v1",
        "continuity_binding_ref": "vendor-session-slot:primary"
      },
      "safe_close": {
        "idle_detection": "always",
        "drain_sequence": []
      },
      "startup_gate": {
        "scope": "harness_verified_workspace",
        "prompt_rules": [
          {
            "rule_id": "startup.claude-workspace-trust",
            "prompt_pattern": "(?s)Accessing\\s+workspace:.*Quick\\s+safety\\s+check:.*\\n[ \\t]*❯[ \\t]+No,\\s+exit[ \\t]*\\n[ \\t]+Yes,\\s+I\\s+trust\\s+this\\s+folder[ \\t]*\\n\\s*Enter\\s+to\\s+confirm",
            "confirm_sequence": ["\u001b[B", "\r"],
            "requires_workspace_path": true
          }
        ],
        "ready_pattern": "(?m)^\\s*❯\\s*$",
        "timeout_seconds": 180
      }
    }
  ]
}
